# ===============================================
# ClimateShield Frontend - Environment Configuration
# ===============================================

# API Base URL (defaults to /api or http://localhost:5000/api)
VITE_API_BASE_URL="http://localhost:5000/api"

# Supabase Public Anonymous Client Credentials (safe for browser exposure)
VITE_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
VITE_SUPABASE_ANON_KEY="[YOUR-SUPABASE-ANON-KEY]"

# Map Tile Configuration (OpenStreetMap is zero-config)
VITE_MAP_TILE_PROVIDER="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
