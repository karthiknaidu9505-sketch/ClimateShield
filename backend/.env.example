# ===============================================
# ClimateShield Backend - Environment Configuration
# Current Supabase API Key & PostgreSQL Model
# ===============================================

PORT=5000
NODE_ENV=development

# ── 1. Supabase PostgreSQL Connection (Prisma) ─────────────
# Transaction connection pooler (port 6543) for application queries:
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (port 5432) for Prisma migrations and schema push:
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# ── 2. Supabase Current API Key Model ──────────────────────
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_JWKS_URL="https://[YOUR-PROJECT-REF].supabase.co/auth/v1/.well-known/jwks.json"

# ── 3. AI Decision Support (Phase 4) ───────────────────────
GEMINI_API_KEY=""
