# ===============================================
# ClimateShield Backend - Environment Configuration
# Current Supabase API Key & PostgreSQL Model
# ===============================================

PORT=5000
NODE_ENV=production

# ── 1. Supabase PostgreSQL Connection (Prisma) ─────────────
# Required: Transaction connection pooler (port 6543) for application queries:
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Required: Direct connection (port 5432) for Prisma migrations and schema push:
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# ── 2. Supabase Authentication & Admin API Keys ────────────
# Required: Supabase project URL
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"

# Required: Supabase Secret Key (service role) for administrative database & auth operations
SUPABASE_SECRET_KEY="sb_secret_..."

# Required: Supabase Publishable Key (anon key)
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Required: JWKS endpoint for cryptographic JWT token validation
SUPABASE_JWKS_URL="https://[YOUR-PROJECT-REF].supabase.co/auth/v1/.well-known/jwks.json"

# ── 3. Cross-Origin Resource Sharing (CORS) ─────────────────
# Optional: Allowed origins for API requests.
# Defaults to "*" to allow connectivity from any frontend origin during deployment.
# For production hardening, set to your deployed frontend domain(s), comma-separated:
# CORS_ORIGIN="https://climateshield.vercel.app"
CORS_ORIGIN="*"

# ── 4. AI Decision Support (Phase 4 - Not Required for Deployment) ─
# GEMINI_API_KEY is not required for the current deployment because AI Phase 4 has not been implemented.
# GEMINI_API_KEY=""
