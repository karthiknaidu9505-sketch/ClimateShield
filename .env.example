# ===============================================
# ClimateShield Platform - Environment Configuration
# ===============================================

# Backend Configuration
PORT=5000
NODE_ENV=development

# Database Connection
# For PostgreSQL (Production / Standard Setup):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/climateshield?schema=public"
#
# For Local Zero-Config Setup (SQLite fallback for immediate offline evaluation):
DATABASE_URL="file:./dev.db"

# JWT Secret (for session / auth demo tokens)
JWT_SECRET="climateshield-secure-ops-token-jwt-secret-2024"

# Frontend Configuration
VITE_API_BASE_URL="http://localhost:5000/api"

# Map Configuration (Leaflet / OpenStreetMap is zero-config and does not require an API key)
VITE_MAP_TILE_PROVIDER="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
